<header id="top-header">
  <span class="siteName">
    <a href="/" title="Return to home page">CSE Motors</a>
  </span>
  
  <div id="tools">
    <% if (typeof loggedin !== 'undefined' && loggedin === true) { %>
      <a title="Manage your account" href="/account">
        Welcome <%= accountData && accountData.account_firstname ? accountData.account_firstname : 'User' %>
      </a>
      <a title="Click to log out" href="/account/logout">Logout</a>
    <% } else { %>
      <a title="Click to log in" href="/account/login">My Account</a>
    <% } %>
  </div>
</header>