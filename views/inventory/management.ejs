<% if (title) { %>
  <h1><%= title %></h1>
<% } else { %>
  <% res.redirect('/') %>
<% } %>

<%- messages() %>

<p>Use the links below to add inventory classifications or inventory items.</p>

<ul>
  <li><a href="/inv/add-classification">Add New Classification</a></li>
  <li><a href="/inv/add-inventory">Add New Inventory</a></li>
</ul>

<h2>Manage Inventory</h2>
<p>Select a classification from the list to see items that belong to that classification.</p>

<% if (typeof classificationList !== "undefined") { %>
  <div id="classificationSelector"><%- classificationList %></div>
<% } %>

<table id="inventoryDisplay"></table>
<noscript>JavaScript must be enabled to use this page.</noscript>

<script src="/js/script.js"></script>
