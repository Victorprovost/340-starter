<% if (title) { %>
  <h1><%= title %></h1>
<% } else { %>
  <% res.redirect('/') %>
<% } %>

<%- messages() %>

<% if (typeof errors !== "undefined" && errors.length) { %>
  <div class="flash-message">
    <ul>
      <% errors.forEach(function (error) { %>
        <li><%= error.msg %></li>
      <% }) %>
    </ul>
  </div>
<% } %>

<form action="/inv/add-inventory" method="post" class="login-form">
  <label for="classificationList">Classification</label>
  <div class="password-hint">
    Choose the vehicle classification from the list.
  </div>
  <%- classificationList %>

  <label for="inv_make">Make</label>
  <input
    type="text"
    id="inv_make"
    name="inv_make"
    required
    maxlength="50"
    value="<%= typeof inv_make !== 'undefined' ? inv_make : '' %>"
  >

  <label for="inv_model">Model</label>
  <input
    type="text"
    id="inv_model"
    name="inv_model"
    required
    maxlength="50"
    value="<%= typeof inv_model !== 'undefined' ? inv_model : '' %>"
  >

  <label for="inv_description">Description</label>
  <textarea
    id="inv_description"
    name="inv_description"
    required
    rows="4"
  ><%= typeof inv_description !== 'undefined' ? inv_description : '' %></textarea>

  <label for="inv_image">Image Path</label>
  <input
    type="text"
    id="inv_image"
    name="inv_image"
    required
    value="<%= typeof inv_image !== 'undefined' ? inv_image : '/images/vehicles/no-image.png' %>"
  >
  <div class="password-hint">
    Use <code>/images/vehicles/no-image.png</code> if no image is available.
  </div>

  <label for="inv_thumbnail">Thumbnail Path</label>
  <input
    type="text"
    id="inv_thumbnail"
    name="inv_thumbnail"
    required
    value="<%= typeof inv_thumbnail !== 'undefined' ? inv_thumbnail : '/images/vehicles/no-image-tn.png' %>"
  >

  <label for="inv_price">Price</label>
  <input
    type="number"
    id="inv_price"
    name="inv_price"
    required
    min="0.01"
    step="0.01"
    value="<%= typeof inv_price !== 'undefined' ? inv_price : '' %>"
  >

  <button type="submit">Add Inventory</button>
</form>

<p><a href="/inv">Back to Inventory Management</a></p>
