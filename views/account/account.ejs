<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

  <main class="login-container">
    <h1><%= title %></h1>

    <%- messages() %>

    <% if (typeof errors !== "undefined" && errors) { %>
      <div class="flash-message">
        <ul class="notice">
          <% errors.array().forEach(function (error) { %>
            <li><%= error.msg %></li>
          <% }) %>
        </ul>
      </div>
    <% } %>

    <p>You're logged in</p>
  </main>

</body>
</html>
